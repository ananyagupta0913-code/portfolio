---
import { site } from "@/data/site";
interface Props {
  title: string;
}

const { title } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
// Full web address of your site, built automatically from astro.config.mjs
// (the "site" and "base" settings), so you never type it here.
const siteUrl = `${Astro.site?.origin ?? ""}${baseUrl.replace(/\/$/, "")}/`;

// Info for Google ("structured data"), built from src/data/site.ts
const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: siteUrl,
  image: `${siteUrl}og.image.png`,
  sameAs: [site.github, site.linkedin],
  jobTitle: site.role,
  description: site.description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | Portfolio</title>
    <meta
      name="description"
      content={site.description}
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${baseUrl}/favicon.png`} />
    <link rel="canonical" href={siteUrl} />

    <link
      rel="preload"
      href={`${baseUrl}/fonts/montserrat-latin-wght-normal.woff2`}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta
      property="og:title"
      content={`${site.name} | ${site.role}`}
    />
    <meta
      property="og:description"
      content={site.description}
    />
    <meta
      property="og:image"
      content={`${siteUrl}og.image.png`}
    />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content={`${site.name} Portfolio`}
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }
</style>
